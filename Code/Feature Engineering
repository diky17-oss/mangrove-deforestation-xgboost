import rasterio
import numpy as np

# Vegetation indices
def calc_index(numerator, denominator):
    return np.where((denominator == 0), 0, numerator / denominator)

def calc_ndvi(nir, red): return calc_index(nir - red, nir + red)
def calc_savi(nir, red, L=0.5): return ((nir - red) / (nir + red + L)) * (1 + L)
def calc_osavi(nir, red): return ((nir - red) / (nir + red + 0.16)) * (1 + 0.16)
def calc_ipvi(nir, red): return nir / (nir + red)
def calc_dvi(nir, red): return nir - red
def calc_gndvi(nir, green): return calc_index(nir - green, nir + green)
def calc_ndwi(green, nir): return calc_index(green - nir, green + nir)
def calc_mndwi(green, swir): return calc_index(green - swir, green + swir)
def calc_lswi(nir, swir): return calc_index(nir - swir, nir + swir)

# SAR
def ratio(a, b):
    return np.where(b == 0, 0, a / b)

def entropy(vv, vh):
    total = vv + vh + 1e-8
    p_vv = vv / total
    p_vh = vh / total

    with np.errstate(divide='ignore', invalid='ignore'):
        log_p_vv = np.log2(p_vv)
        log_p_vh = np.log2(p_vh)

        log_p_vv = np.where(p_vv > 0, log_p_vv, 0)
        log_p_vh = np.where(p_vh > 0, log_p_vh, 0)

    H = -(p_vv * log_p_vv + p_vh * log_p_vh)
    return np.nan_to_num(H, nan=0.0, neginf=0.0, posinf=0.0)

def alpha(vv, vh):
    return np.arctan2(vh, vv)  # radian

def anisotropy(vv, vh):
    numerator = np.abs(vv - vh)
    denominator = vv + vh + 1e-8
    return numerator / denominator

